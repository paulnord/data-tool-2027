    "source": {
      "application": "Synthetic Moyal example",
      "version": "2026-10-07",
      "context": "Synthetic data: integer Poisson counts in unit-width channels; not measured detector data.\nGenerating means: 10000 times the Moyal probability integrated from channel-0.5 to channel+0.5.\nTruth: background=0 count/channel, total expected events=10000, mpv=50 channel, w=5 channel.\nAssigned Poisson error estimate: sqrt(N) count; empty channels use 1 count (sqrt(max(N,1))).\nNumPy PCG64 seed 20261007; NumPy 2.3.5, SciPy 1.17.0.\nGenerator: scripts/generate-moyal-reference.py.\nReference: https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.moyal.html\nOpen moyal.trksess for assigned uncertainties and starting values; or import the CSV,\nassign column 3 as Y uncertainty, enable advanced models, and select Moyal peak.\nb starts fixed at zero. The fitted curve is evaluated at channel centers, not bin-integrated.\nWeighted least squares with observed-count errors is an approximation, especially for sparse channels.\nGaussian/model assumptions remain unconfirmed; conditional inference is enabled for approximate errors.\nA is full-curve area in count*channel; unit-width channels give it the scale of total counts.",
      "fileName": "moyal.csv"
    },
    "dataset": {
      "id": "synthetic-moyal",
      "label": "Synthetic Moyal peak",
      "xColumn": {
        "id": "x",
        "label": "Channel",
        "unit": "channel"
      },
      "yColumn": {
        "id": "y",
        "label": "Counts",
        "unit": "count"
      },
      "assumptions": {
        "exactX": "asserted",
        "gaussianIndependent": "unknown",
        "correctModel": "unknown"
      },
