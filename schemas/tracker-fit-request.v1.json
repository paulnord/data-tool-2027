{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "tracker-fit-request"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "source": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fileName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "application",
        "version",
        "context"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "xColumn": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "label",
            "unit"
          ],
          "additionalProperties": false
        },
        "yColumn": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "label",
            "unit"
          ],
          "additionalProperties": false
        },
        "assumptions": {
          "type": "object",
          "properties": {
            "exactX": {
              "type": "string",
              "enum": [
                "asserted",
                "unknown",
                "known-false"
              ]
            },
            "gaussianIndependent": {
              "type": "string",
              "enum": [
                "asserted",
                "unknown",
                "known-false"
              ]
            },
            "correctModel": {
              "type": "string",
              "enum": [
                "asserted",
                "unknown",
                "known-false"
              ]
            }
          },
          "required": [
            "exactX",
            "gaussianIndependent",
            "correctModel"
          ],
          "additionalProperties": false
        },
        "rows": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "y": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "included": {
                "type": "boolean"
              },
              "missingReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "missing-value",
                      "out-of-bounds",
                      "calculation-error"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "included",
              "missingReason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "label",
        "xColumn",
        "yColumn",
        "assumptions",
        "rows"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "errorStructure": {
              "type": "string",
              "enum": [
                "uncorrelated",
                "known-correlated",
                "unknown"
              ]
            },
            "kind": {
              "type": "string",
              "const": "unknown-equal"
            }
          },
          "required": [
            "errorStructure",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "errorStructure": {
              "type": "string",
              "enum": [
                "uncorrelated",
                "known-correlated",
                "unknown"
              ]
            },
            "kind": {
              "type": "string",
              "const": "supplied-common"
            },
            "sigmaY": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "provenance": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user-asserted",
                    "instrument-calibrated",
                    "unknown"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "errorStructure",
            "kind",
            "sigmaY",
            "provenance"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "errorStructure": {
              "type": "string",
              "enum": [
                "uncorrelated",
                "known-correlated",
                "unknown"
              ]
            },
            "kind": {
              "type": "string",
              "const": "supplied-per-row"
            },
            "sigmaByRow": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "provenance": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user-asserted",
                    "instrument-calibrated",
                    "unknown"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "errorStructure",
            "kind",
            "sigmaByRow",
            "provenance"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format",
    "version",
    "requestId",
    "snapshotId",
    "source",
    "dataset",
    "uncertainty"
  ],
  "additionalProperties": false,
  "title": "Tracker fit request v1",
  "$comment": "Structural schema. Also apply semantic rules in schemas/README.md: unique identities, row associations, missing-value consistency, model parameter count and assumption consistency."
}
