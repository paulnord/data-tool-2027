{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Tool 2027",
  "version": "0.3.0",
  "identifier": "org.opensourcephysics.datatool2027",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Data Tool 2027",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["trksess"],
        "name": "Data Tool analysis session",
        "role": "Editor"
      }
    ],
    "resources": {
      "../examples/data/": "Examples/"
    },
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
